# Copy to .env. Supply your own credentials; never commit .env.
RUSTDB_DATABASE_URL=postgresql://rustdb:CHANGE_ME@localhost:5432/rustdb
# Base64 encoding of exactly 32 cryptographically random bytes.
RUSTDB_ENCRYPTION_KEY=
RUSTDB_BOOTSTRAP_TOKEN=
RUSTDB_BIND_ADDRESS=127.0.0.1
RUSTDB_PORT=8080
RUST_LOG=info
RUSTDB_QUERY_TIMEOUT_SECONDS=30
RUSTDB_CONNECT_TIMEOUT_SECONDS=5
RUSTDB_MAX_ROWS=1000
RUSTDB_CORS_ORIGIN=http://localhost:5173
RUSTDB_STATIC_DIR=frontend/dist
# Optional container build-stage image override (not used by the running server).
RUSTDB_BUILD_IMAGE=rust:slim-bookworm
POSTGRES_USER=rustdb
POSTGRES_PASSWORD=
POSTGRES_DB=rustdb
